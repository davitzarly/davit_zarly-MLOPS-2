# Dockerfile untuk Grafana (bonus - sinkronisasi Prometheus & Grafana)
FROM grafana/grafana:10.1.0

# Copy provisioning files dan dashboard
COPY grafana/provisioning /etc/grafana/provisioning
COPY grafana/dashboards /var/lib/grafana/dashboards

# Override defaults via environment
ENV GF_SECURITY_ADMIN_PASSWORD=admin \
    GF_USERS_ALLOW_SIGN_UP=false \
    GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/neu-det-dashboard.json

EXPOSE 3000
