# ====================================================================== #
# Prometheus auxiliary configuration file
# ====================================================================== #
# File ini berisi konfigurasi tambahan yang sering dipakai untuk
# environment production seperti alerting rules, retention, dan
# remote_write/remote_read ke storage eksternal (Thanos, Cortex, dst).
# Pada submission ini file disertakan sebagai placeholder sesuai
# ketentuan submission Dicoding (prometheus.config wajib ada).
# ====================================================================== #

# ---------------------------------------------------------------- #
# Alerting rules - dipakai jika Alertmanager aktif
# ---------------------------------------------------------------- #
groups:
  - name: neu_det_model_alerts
    interval: 30s
    rules:
      # Alert 1: error rate > 5% dalam 5 menit terakhir
      - alert: HighErrorRate
        expr: |
          sum(rate(model_predict_errors_total[5m]))
            / sum(rate(model_predict_total[5m])) > 0.05
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Error rate model > 5%"
          description: "Lebih dari 5% request /predict gagal dalam 5 menit terakhir."

      # Alert 2: latency p95 > 1 detik
      - alert: HighLatency
        expr: |
          histogram_quantile(0.95,
            sum(rate(model_predict_latency_seconds_bucket[5m])) by (le)
          ) > 1.0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Latency p95 > 1s"
          description: "Latency p95 endpoint /predict lebih dari 1 detik selama 5 menit."

      # Alert 3: model down - tidak ada metric predict_total dalam 2 menit
      - alert: ModelDown
        expr: absent(model_predict_total) or (rate(model_predict_total[2m]) == 0)
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Model serving tidak menerima request"
          description: "Tidak ada metric /predict dalam 2 menit terakhir - kemungkinan app down."
